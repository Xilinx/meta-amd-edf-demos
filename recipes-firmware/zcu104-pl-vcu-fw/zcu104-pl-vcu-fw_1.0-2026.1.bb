inherit dfx_user_dts

SRC_URI = "https://edf.amd.com/sswreleases/rel-v2026.1/edf_files/2026.1/02200415/external/fwapp/zcu104-pl-vcu-fw_2026.1_0219_1_02200415.tar.gz"

