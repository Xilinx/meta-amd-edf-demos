LICENSE = "MIT"
LIC_FILES_CHKSUM = "file://${COMMON_LICENSE_DIR}/MIT;md5=0835ade698e0bcf8506ecda2f7b4f302"

inherit dfx_user_dts

SRC_URI = "https://edf.amd.com/sswreleases/rel-v2026.1/edf_files/2026.1/06030659/external/fwapp/zcu104-pl-vcu-fw_2026.1_0603_1_06030659.tar.gz"

SRC_URI[sha256sum] = "c67053bfc7a2bfe41cef7c2e241b2439dfbc624c9c1c5c03d3776f1f5394948d"

COMPATIBLE_MACHINE = "^$"
COMPATIBLE_MACHINE:amd-cortexa53-mali-common = "${MACHINE}"
