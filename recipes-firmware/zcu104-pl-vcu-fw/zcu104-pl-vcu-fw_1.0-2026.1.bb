LICENSE = "MIT"
LIC_FILES_CHKSUM = "file://${COMMON_LICENSE_DIR}/MIT;md5=0835ade698e0bcf8506ecda2f7b4f302"

inherit dfx_user_dts

SRC_URI = "https://edf.amd.com/sswreleases/rel-v2026.1/edf_files/2026.1/04171450/external/fwapp/zcu104-pl-vcu-fw_2026.1_0417_1_04171450.tar.gz"

SRC_URI[sha256sum] = "ea3bc9d5ee834043dc0bc8c7dc2605dbca43ca80b107e9ea3004cdba9bbc71de"

COMPATIBLE_MACHINE = "^$"
COMPATIBLE_MACHINE:amd-cortexa53-mali-common = "${MACHINE}"
